{
  "name": "Better Mile Wide Back",
  "author": "cUDGk",
  "version": "0.4",
  "description": "__MSG_extensionDescription__",
  "manifest_version": 3,
  "default_locale": "en",
  "homepage_url": "https://github.com/cUDGk/better-mile-wide-back",

  "permissions": [
    "storage"
  ],

  "optional_permissions": [
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],

  "options_ui": {
    "page": "options.htm"
  }
}
